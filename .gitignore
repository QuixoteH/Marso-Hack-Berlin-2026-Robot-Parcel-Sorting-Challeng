# pixi environments
.pixi/*
!.pixi/config.toml

# run outputs / checkpoints
outputs/

# python
__pycache__/
*.pyc
*.egg-info/
.ipynb_checkpoints/

# editor / local settings
.vscode/
.claude/

# IL track generated artifacts (checkpoints already covered by *.pt)
il/videos/
il/baselines/*/runs/
il/demos/**/*.json
*.h5
*.mp4
# Demo datasets (rgb) are large and exceed GitHub's file-size limit, so they are NOT in git —
# they're hosted as a Release asset and fetched with il/download_demos.py (see README). Only the
# small demo media (gif/mp4) ships in the repo.
!media/*_demo.mp4

# run logs (training/eval/gen stdout captured to files)
*.log

il/baselines/act/runs/

# Experiment artifacts are retained locally and listed in RELEASE_MANIFEST.md.
# Keep only compact reports, scripts, JSON manifests, and checksum files in Git.
/experiments/checkpoints/*.pt
/experiments/datasets/**/*.h5
/experiments/logs/
/experiments/runner_state/
/experiments/*.tar.gz

# Local source delivery packages and generated data are not part of the GitHub repo.
*.tar.gz
*.zip

# Small archived logs are evidence, not generated worktree output.
!实验档案/**/*.log
